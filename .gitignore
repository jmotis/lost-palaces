# This repository holds the website and the page file of each 3D model.
# Anything else added to the project folder stays local and is ignored.
#
# The models' images (each model's assets/ folder) are also left out for now,
# until their copyright status has been checked one by one. To add a model's
# images later, add a line like:
#   !/Greenwich/assets/
# below the model's page file.

# Ignore everything at the top level by default...
/*

# ...except this file, the README and the website.
!/.gitignore
!/README.md
!/Hugo-site/

# The 3D models: only each model's page file (the file the website publishes).
!/Baynards Castle/
/Baynards Castle/*
!/Baynards Castle/baynardscastle.html

!/Beaulieu/
/Beaulieu/*
!/Beaulieu/beaulieu.html

!/Bridewell/
/Bridewell/*
!/Bridewell/bridewell.html

!/Greenwich/
/Greenwich/*
!/Greenwich/index.html

!/Nonsuch/
/Nonsuch/*
!/Nonsuch/index.html

!/Oatlands/
/Oatlands/*
!/Oatlands/oatlands.html

!/Richmond/
/Richmond/*
!/Richmond/index.html

!/The More/
/The More/*
!/The More/index.html

!/Whitehall/
/Whitehall/*
!/Whitehall/index.html

# macOS Finder folder settings, anywhere
.DS_Store
